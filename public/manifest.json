{
  "manifest_version": 3,
  "incognito": "not_allowed",
  "name": "AI Usage Monitor",
  "version": "1.0.10",
  "description": "Monitor reported Claude subscription quotas locally, with forecasts, history, and transparent Codex connection diagnostics.",
  "permissions": [
    "storage",
    "alarms"
  ],
  "optional_permissions": [
    "notifications",
    "idle"
  ],
  "host_permissions": [
    "https://claude.ai/*",
    "https://chatgpt.com/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "AI Usage Monitor",
    "default_icon": "icons/monitor.svg"
  },
  "icons": {
    "48": "icons/monitor.svg",
    "96": "icons/monitor.svg"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "ai-usage-monitor@local.extension",
      "update_url": "https://demilio5.github.io/ai-usage-monitor/updates.json",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src https://claude.ai https://chatgpt.com"
  }
}
